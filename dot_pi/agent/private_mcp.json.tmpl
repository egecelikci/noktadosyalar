{
  "mcpServers": {
{{- if eq .chezmoi.os "darwin" }}
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82",
        "--executable-path",
        "/Users/egecelikci/Applications/Helium.app/Contents/MacOS/Helium"
      ],
      "env": {
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
      }
    },
    "nixos": {
      "command": "/Users/egecelikci/.local/bin/uvx",
      "args": [
        "mcp-nixos"
      ]
    }
{{- else if eq .chezmoi.os "linux" }}
    "nixos": {
      "command": "/etc/profiles/per-user/egecelikci/bin/mcp-nixos"
    },
    "rea": {
      "command": "/etc/profiles/per-user/egecelikci/bin/npx",
      "args": [
        "-y",
        "rea-agents@6.2.0",
        "mcp"
      ],
      "env": {
        "PATH": "/etc/profiles/per-user/egecelikci/bin:/run/current-system/sw/bin"
      }
    },
    "forgejo": {
      "command": "/etc/profiles/per-user/egecelikci/bin/forgejo-mcp",
      "args": [
        "--transport",
        "stdio"
      ]
    }
{{- end }}
  }
}
