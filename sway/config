# sway config.
# ~/.config/sway/config is a symlink to this file in the chezmoi source (dot_config/sway/symlink_config.tmpl), so an edit here is live after `Super+Shift+C` and is versioned the moment it is committed: there is no `chezmoi apply` step in between.
# Built on sway's own default config (/etc/sway/config), so `man 5 sway` and every tutorial describe these keys.
#
# The mental model, one rule per modifier:
# - `Super+key` does a thing: focus, open, switch, toggle.
# - `Super+Shift+key` does the same thing to the focused window, or does the dangerous version of it: move instead of focus, send instead of switch, close, reload, exit.
# - `Super+Ctrl+key` is reserved for the session itself (lock).
# - `h j k l` are left, down, up, right everywhere, and the arrow keys (Fn layer on the 60%) do the same.

# The NixOS sway module's drop-in: dbus-update-activation-environment plus the systemctl --user import-environment and sway-session.target start.
# A custom config silently drops them unless it includes the directory, and then portals and systemd user services never see WAYLAND_DISPLAY.
include /etc/sway/config.d/*

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu fuzzel
set $lock swaylock -f -c 1d1f21

# Turkish Q, plus two remaps done here rather than in the NuPhy firmware, so they are versioned and undone by deleting a word:
# - `caps:backspace` turns Caps Lock into a second Backspace.
# - `altwin:swap_lalt_lwin` swaps the bottom-left Alt and Win, so Super sits under the left thumb, next to the space bar.
# If the same swap is ever done in the keyboard's firmware instead, delete these options, or the two swaps cancel out.
input "type:keyboard" {
  xkb_layout tr
  xkb_options caps:backspace,altwin:swap_lalt_lwin
}

output * bg #1d1f21 solid_color

# Session services: notifications, and locking after 10 minutes idle (the screen goes off at 15, and the session locks before any suspend).
exec fnott
exec swayidle -w \
  timeout 600 '$lock' \
  timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
  before-sleep '$lock'

### Basics
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
# Drag floating windows with Super + left mouse button, resize them with Super + right.
floating_modifier $mod normal
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes, exit sway' 'swaymsg exit'
bindsym $mod+Ctrl+$right exec $lock

### Focus and move
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces: Super+N goes there, Super+Shift+N sends the window there.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
# Back to the workspace you came from.
bindsym $mod+Tab workspace back_and_forth

### Layout
# Where the next window opens: beside (b) or below (v) the focused one.
bindsym $mod+b splith
bindsym $mod+v splitv
# Stacking, tabbed, or back to tiled.
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

### Scratchpad: a hidden workspace for windows you summon and dismiss.
# On Turkish Q, `minus` is the key right of `*` on the number row.
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

### Resize: Super+R, then hjkl or arrows, then Return or Escape.
mode "resize" {
  bindsym $left resize shrink width 10px
  bindsym $down resize grow height 10px
  bindsym $up resize shrink height 10px
  bindsym $right resize grow width 10px
  bindsym Left resize shrink width 10px
  bindsym Down resize grow height 10px
  bindsym Up resize shrink height 10px
  bindsym Right resize grow width 10px
  bindsym Return mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Screenshots: there is no Print key on a 60% board.
# Super+Shift+S: drag a region, copied to the clipboard. Super+Shift+P: the whole screen, into ~/Pictures.
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Shift+p exec mkdir -p ~/Pictures && grim ~/Pictures/$(date +%F_%H-%M-%S).png

### Media keys, through the PipeWire that is already running. --locked keeps them working on the lock screen.
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

### Bar: sway's own, with the date. Super+Shift+B hides it.
bar {
  position top
  status_command while date +'%a %d %b  %H:%M'; do sleep 30; done
  colors {
    statusline #c5c8c6
    background #1d1f21
    inactive_workspace #1d1f21 #1d1f21 #707880
  }
}
bindsym $mod+Shift+b bar mode toggle
