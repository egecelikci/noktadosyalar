.config/rclone/rclone.conf

# Pi: per-machine session history and model cache. auth.json IS managed
# (templated from Bitwarden Secrets Manager), so it is not ignored.
.pi/agent/sessions
.pi/agent/models-store.json

# Team Fortress 2
mastercomfig/

# Desktop configs that are edited while they run.
# The real files live in these source directories, and ~/.config/<name> is a symlink to them (dot_config/symlink_<name>.tmpl).
# An edit is therefore live at once (sway: Super+Shift+C, waybar and mako: reloaded by that too), and versioned by a commit here: there is no `chezmoi apply` in between, and nothing for apply to overwrite.
# Ignored as targets because chezmoi would otherwise also create ~/sway, ~/waybar and ~/mako.
sway/
waybar/
mako/

{{ if ne .chezmoi.os "linux" }}
# The sway desktop and what it calls exist on the Linux machine only.
.config/sway
.config/waybar
.config/mako
.local/bin/volume
{{ end }}

{{ if ne .chezmoi.os "android" }}
# Termux-only wrapper (dot_local/bin/executable_bws.tmpl). Ignored elsewhere,
# because an empty rendering would otherwise delete a real ~/.local/bin/bws.
.local/bin/bws
{{ end }}

{{ if eq .chezmoi.os "linux" }}
# The server's restic credentials come from sops (nixos repo:
# modules/backup.nix). .backup_env.fish is for the phone's backup.fish and the
# Mac's migrate_hdd.fish only.
.backup_env.fish
.config/restic
{{ end }}

{{ if eq .chezmoi.os "android" }}
# Server-only configuration and credentials. None of it is used on the phone,
# and several of these files hold secrets (tunnel credentials, service
# passwords, the restic password).
.config/restic

# Pi is not used on the phone.
.pi
install-pi-packages.fish
{{ end }}

