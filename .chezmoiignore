.config/rclone/rclone.conf

# Repository-only regression tests.
tests/

# Noctalia owns Foot's config and the generated Sway colour fragment.
.config/foot
.config/sway/noctalia

# Team Fortress 2
mastercomfig/

# Deadlock: linked into the game by dot_local/share/Steam/…/symlink_autoexec.cfg.tmpl, so edits here are live.
deadlock/

{{ if ne .chezmoi.os "linux" }}
# The Sway session and its terminal file picker exist on the Linux machine only.
.config/sway
.config/xdg-desktop-portal-termfilechooser
# Deadlock is installed on the Linux machine only.
.local/share/Steam
{{ end }}

{{ if ne .chezmoi.os "android" }}
# Termux-only wrapper (dot_local/bin/executable_bws.tmpl). Ignored elsewhere,
# because an empty rendering would otherwise delete a real ~/.local/bin/bws.
.local/bin/bws
{{ end }}

{{ if eq .chezmoi.os "linux" }}
# The server's restic credentials come from sops (nixos repo:
# modules/backup.nix). .backup_env.fish is for the phone's backup.fish and the
# Mac's migrate_hdd.fish only.
.backup_env.fish
.config/restic
{{ end }}

{{ if eq .chezmoi.os "android" }}
# Server-only configuration and credentials. None of it is used on the phone,
# and several of these files hold secrets (tunnel credentials, service
# passwords, the restic password).
.config/restic
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
# macOS-only app benchmark utility (uses Darwin top, pbcopy, osascript, and .app bundles).
.local/bin/app-bench
.config/fish/completions/app-bench.fish
{{ end }}

