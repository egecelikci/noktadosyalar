directory: {{ if eq .chezmoi.os "darwin" }}/Volumes/Toshiba/Music/Library{{ else }}/mnt/media/Music/Library{{ end }}
library: {{ if eq .chezmoi.os "darwin" }}~/.config/beets/library.db{{ else }}/var/lib/beets/library.db{{ end }}

paths:
  comp: Compilations/%if{$year,[$year] ,}$album$atypes%aunique{}/%if{$isMultidisc,Disc $disc/}$track. $artist - $title
  singleton: Non-Album/$albumartist - $title
  default: $albumartist/%if{$year,[$year] ,}$album$atypes%aunique{}/%if{$isMultidisc,Disc $disc/}$track. $title

per_disc_numbering: yes
artist_credit: no
threaded: yes
asciify_paths: yes

import:
  write: yes
  move: no
  copy: yes
  autotag: yes
  quiet_fallback: skip
  timid: no
  detail: yes
  duplicate_action: ask
  duplicate_keys:
    album: albumartist album mb_albumid
    item: artist title
  log: {{ if eq .chezmoi.os "darwin" }}~/.config/beets/import.log{{ else }}/var/lib/beets/import.log{{ end }}

plugins:
  - musicbrainz
  - chroma
  - fromfilename
  - albumtypes
  - badfiles
  - convert
  - duplicates
  - edit
  - embedart
  - export
  - fetchart
  - importadded
  - importsource
  - info
  - inline
  - lyrics
  - mbcollection
  - mbsubmit
  - mbsync
  - missing
  - parentwork
  - replaygain
  - scrub
  - smartplaylist
  - subsonicupdate
{{ if eq .chezmoi.os "linux" }}
  - filetote
  - titlecase
  - web
{{ end }}
  - zero

web:
  host: 127.0.0.1
  port: 5001
  readonly: yes

aunique:
  keys: albumartist album
  disambiguators: albumtype year label catalognum albumdisambig releasegroupdisambig mb_albumid
  bracket: '()'

zero:
  fields: comments grouping encoder
  update_database: yes

missing:
  format: $albumartist - $album - $title
  count: yes
  total: yes

duplicates:
  checksum: yes
  tiebreak:
    items: [bitrate]

chroma:
  auto: no

parentwork:
  force: no
  auto: yes

replaygain:
  auto: yes
  backend: ffmpeg
  threads: 8

scrub:
  auto: yes

filetote:
  extensions: .cue .CUE .log .LOG .accurip .ACCURIP .ffp .FFP .md5 .MD5 .sfv .SFV .txt .TXT .nfo .NFO .pdf .PDF
  patterns:
    artworkdir:
      - "[aA]rtwork/"
      - "[sS]cans/"
  print_ignored: true

badfiles:
  check_on_import: yes
  import_action_on_warning: continue
  import_action_on_error: skip
  commands:
    flac: flac --test --silent
    m4a: ffmpeg -v error -f null - -i
    mp3: mp3val

fetchart:
  auto: yes
  maxwidth: 1200
  quality: 85
  cover_format: JPEG
  cautious: yes
  sources:
    - filesystem
    - coverart: release releasegroup

embedart:
  auto: yes
  remove_art_file: no
  maxwidth: 1200

edit:
  albumfields: album albumartist year genres label catalognum albumtype albumtypes country media
  itemfields: track title artist album genres composers lyricists year
  ignore_fields: id path

subsonic:
  url: https://music.balcova.online
  user: egecelikci
  pass: '{{ (bitwardenSecrets .bitwarden.navidrome_password_id).value }}'
  auth: token

titlecase:
  auto: no
  fields:
    - album
    - title
    - albumartist
    - artist
  preserve: []

item_fields:
  isMultidisc: 1 if disctotal > 1 else 0

convert:
  auto: no
  dest: {{ if eq .chezmoi.os "darwin" }}~/Music/Portable{{ else }}/mnt/media/Music/Portable{{ end }}
  format: flac
  formats:
    flac:
      command: flac --best -e -p --preserve-modtime --force --verify $source -o $dest
      extension: flac

musicbrainz:
  user: egecelikci
  pass: '{{ (bitwardenSecrets .bitwarden.musicbrainz_password_id).value }}'
  extra_tags: [barcode, catalognum, country, label, media, year]
  genres: yes
  external_ids:
    discogs: no
    bandcamp: yes
    spotify: yes
    deezer: yes
    beatport: no
    tidal: yes

mbcollection:
  auto: no
  collection: "0f143c2a-3b4b-41bc-8c22-9206d0767816"
  remove: yes

lyrics:
  auto: no
  fallback: null
  force: no
  print: no
  sources: [lrclib, lrcmux, genius]
  synced: yes
  keep_synced: yes
  genius_api_key: '{{ (bitwardenSecrets .bitwarden.genius_api_key_id).value }}'

smartplaylist:
  auto: yes
  playlist_dir: {{ if eq .chezmoi.os "darwin" }}~/.config/beets/playlists{{ else }}/var/lib/beets/playlists{{ end }}
  relative_to: {{ if eq .chezmoi.os "darwin" }}/Volumes/Toshiba/Music/Library{{ else }}/mnt/media/Music/Library{{ end }}
  playlists:
    - name: recently-added.m3u
      query: added:-4w..
    - name: recently-released.m3u
      query: year:2024.. added-

match:
  preferred:
    media: ['Digital Media|File']
    original_year: yes
  ignore_case: yes
  ignore_accent: yes
