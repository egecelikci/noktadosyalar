# sway config.
# ~/.config/sway/config is a symlink to dot_config/sway/config in the chezmoi source (symlink mode, see .chezmoi.toml.tmpl there), so an edit is live after `Super+Shift+R` (reload) and versioned by a commit in that repo: there is no `chezmoi apply` step in between.
# Built on sway's own default config (/etc/sway/config), so `man 5 sway` and every tutorial describe these keys; what differs from it is commented where it differs.
#
# The shortcut families:
# - `Super+key` does a thing: focus, open, switch, toggle, close.
# - `Super+Shift+key` moves instead of focusing, sends instead of switching, or reverses parent focus; it also handles reload.
#   Screenshots are `Super+Shift+S` and then W, A or D, laid out like a game's WASD keys (see Screenshots below).
# - `Super+Ctrl+HJKL` controls window size; `Super+Ctrl+Q` locks without ending the session.
# - `h j k l` are left, down, up, right everywhere, as in vim; the arrow keys do the same.
# - A mode (`Super+N` notifications, `Super+Shift+S` screenshot) is a small keyboard of its own: plain letters act, `Escape` leaves, and waybar shows the mode's name while you are in it.
# - Volume and play/pause are the keyboard's job, not sway's: they are on the NuPhy Fn layer, which sends the media keys handled under Media below.

# The NixOS sway module's drop-in: dbus-update-activation-environment, plus the systemctl --user import-environment and sway-session.target start.
# A custom config silently drops them unless it includes the directory, and then portals and systemd user services never see WAYLAND_DISPLAY.
include /etc/sway/config.d/*

# Motif's colors as sway variables ($motif_bg, $motif_primary, $motif_red, … and a `_bare` twin without the `#` for swaylock), generated by motif and reached through the ~/.config/motif symlink.
# Included before anything uses them, because a sway variable must exist before the line that reads it.
include ~/.config/motif/sway/motif-dark.conf

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $lock swaylock -f -c $motif_bg_bare
set $volume ~/.local/bin/volume

### Keyboard
# Turkish Q, and nothing else: every key remap lives in the NuPhy Air60 HE's own firmware (NuPhyIO), so the board behaves the same on every computer and the system never second-guesses it.
# In the firmware (2026-10-16): Caps Lock sends Backspace, and the key directly left of the space bar sends Cmd (Super), with Opt (Alt) beside it.
# Do not add `caps:` or `altwin:` xkb options here; a second remap on top of the firmware's cancels it out, which is what happened before this was removed.
input "type:keyboard" {
  xkb_layout tr
}

### Look
output * bg $motif_bg solid_color
# Sway's own pointer, over the desktop and window borders.
# XCURSOR_THEME (modules/desktop.nix in the nixos repo) only reaches a sway started after it was set; this line also applies on a reload.
seat * xcursor_theme Bibata-Modern-Classic 24
# A 2px border instead of a title bar on every window, and no border at all when a window is alone on its workspace (from emersion's config).
default_border pixel 2
smart_borders on
hide_edge_borders smart
# Window borders from Motif: the focused window wears the accent, the others the quiet border tone, and a window asking for attention the red hue.
# The indicator (where the next window will open) is the accent's pressed shade, so it reads as part of the focus without disappearing into it.
# class                 border            background        text              indicator               child_border
client.focused          $motif_primary    $motif_primary    $motif_bg         $motif_primary_offset   $motif_primary
client.focused_inactive $motif_border     $motif_bg         $motif_text_muted $motif_border          $motif_border
client.unfocused        $motif_border     $motif_bg         $motif_text_muted $motif_border          $motif_border
client.urgent           $motif_red        $motif_red        $motif_bg         $motif_red             $motif_red

### Session services
# mako shows notifications; `exec_always makoctl reload` makes `Super+Shift+R` pick up an edit to ~/.config/mako/config too.
exec mako
exec_always makoctl reload
# Lock after 10 minutes idle, screen off at 15, and always lock before a suspend.
exec swayidle -w \
  timeout 600 '$lock' \
  timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
  before-sleep '$lock'

### Basics
#: Open a terminal (foot)
bindsym --no-repeat $mod+Return exec $term
# Space, like Spotlight or Raycast on macOS; pressing it again closes the launcher.
#: Open or close the app launcher
bindsym --no-repeat $mod+space exec pkill -x fuzzel || fuzzel
#: Close the focused window
bindsym $mod+q kill
# Drag floating windows with Super + left mouse button, resize them with Super + right.
floating_modifier $mod normal
focus_follows_mouse yes
# R for reload: re-reads this file, restarts waybar, reloads mako. Open windows are untouched.
#: Reload sway, waybar and mako after editing a config
bindsym $mod+Shift+r reload
#: Lock the screen
bindsym $mod+Ctrl+q exec $lock

### Focus and move
#: Focus the window left, down, up or right
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

#: Move the window left, down, up or right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces: Super+N goes there, Super+Shift+N sends the window there.
#: Go to workspace 1–10
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
#: Send the window to workspace 1–10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
#: Next workspace
bindsym $mod+Tab workspace next
#: Previous workspace
bindsym $mod+Shift+Tab workspace prev
#: Back to the workspace you came from
bindsym $mod+Ctrl+Tab workspace back_and_forth

### Layout
#: Open the next window beside the focused one
bindsym $mod+b splith
#: Open the next window below the focused one
bindsym $mod+v splitv
#: Stack the windows here (one title bar each)
bindsym $mod+s layout stacking
#: Tab the windows here
bindsym $mod+w layout tabbed
#: Back to tiled, or flip between side by side and stacked
bindsym $mod+e layout toggle split
#: Fullscreen on or off
bindsym $mod+f fullscreen
#: Float the window, or tile it again
bindsym $mod+Shift+space floating toggle
# T for toggle: Super+Space did this in sway's default config; it now opens the launcher.
#: Move focus between tiled and floating windows
bindsym $mod+t focus mode_toggle
#: Focus the parent container
bindsym $mod+a focus parent
#: Focus the last-focused child container
bindsym $mod+Shift+a focus child

### Scratchpad: a hidden workspace for windows you summon and dismiss.
# On Turkish Q, `minus` is the key right of `*` on the number row (the `=` keycap on this board).
#: Hide the window in the scratchpad
bindsym $mod+Shift+minus move scratchpad
#: Show or hide the scratchpad window
bindsym $mod+minus scratchpad show

### Resize: Ctrl controls size directly, without entering a mode.
#: Shrink width or grow height, shrink height or grow width
bindsym $mod+Ctrl+$left resize shrink width 10px
bindsym $mod+Ctrl+$down resize grow height 10px
bindsym $mod+Ctrl+$up resize shrink height 10px
bindsym $mod+Ctrl+$right resize grow width 10px
bindsym $mod+Ctrl+Left resize shrink width 10px
bindsym $mod+Ctrl+Down resize grow height 10px
bindsym $mod+Ctrl+Up resize shrink height 10px
bindsym $mod+Ctrl+Right resize grow width 10px

### Screenshots: Super+Shift+S, then a letter laid out like WASD.
# Keep Super+Shift held and add the letter, or let go and press it alone; both work.
# Escape cancels; until a letter or Escape comes, the bar shows "screenshot" and the other keys do nothing.
# Every screenshot is both copied to the clipboard and saved to ~/Pictures/Screenshots, so there is no second choice to make; mako confirms each one.
# ~/.local/bin/screenshot uses grim and a Motif-colored slurp picker, and lets only one capture run at a time.
# Every binding here is --no-repeat: a held key used to start a new selector on every repeat, stacking dimmed overlays until the screen went white.
# The board has no Print key, which is why these are chords.
set $shot ~/.local/bin/screenshot
mode "screenshot" {
  #: Screenshot a window (click it)
  bindsym --no-repeat w exec $shot window, mode "default"
  #: Screenshot all of the screen
  bindsym --no-repeat a exec $shot screen, mode "default"
  #: Screenshot a region (drag it)
  bindsym --no-repeat d exec $shot area, mode "default"
  #: Screenshot a window (click it)
  bindsym --no-repeat $mod+Shift+w exec $shot window, mode "default"
  #: Screenshot all of the screen
  bindsym --no-repeat $mod+Shift+a exec $shot screen, mode "default"
  #: Screenshot a region (drag it)
  bindsym --no-repeat $mod+Shift+d exec $shot area, mode "default"
  #: Cancel
  bindsym Escape mode "default"
}
#: Screenshot mode (then W, A or D)
bindsym --no-repeat $mod+Shift+s mode "screenshot"

### Media
#: Open the mixer (per-app volume, devices)
bindsym --no-repeat $mod+m exec $term --app-id=mixer wiremix
for_window [app_id="mixer"] floating enable, resize set 900 600

# Volume and playback come from the keyboard: the NuPhy Fn layer sends these media keys, sway acts on them, and they keep working on the lock screen.
# Volume changes show as a mako notification with a level bar, through ~/.local/bin/volume.
#: Volume up, down, mute (keyboard media keys)
bindsym --locked XF86AudioRaiseVolume exec $volume up
bindsym --locked XF86AudioLowerVolume exec $volume down
bindsym --locked XF86AudioMute exec $volume mute
#: Microphone mute (keyboard media key)
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
#: Play/pause, next, previous (keyboard media keys)
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

### Notifications: Super+N, then a letter (from emersion's config).
mode "notifications" {
  #: Dismiss the newest notification
  bindsym d exec makoctl dismiss, mode "default"
  #: Dismiss all notifications
  bindsym Shift+d exec makoctl dismiss --all, mode "default"
  #: Act on the newest (open the chat, the link…) and dismiss it
  bindsym Return exec makoctl invoke && makoctl dismiss, mode "default"
  #: Bring back the last dismissed notification
  bindsym u exec makoctl restore, mode "default"
  #: Cancel
  bindsym Escape mode "default"
}
#: Notifications mode (then D, Shift+D, Enter or U)
bindsym $mod+n mode "notifications"

### Passthrough: every key goes to the focused window, Super included, until the same chord again.
# For games and VMs that want Super for themselves; the bar shows "passthrough" while it is on.
mode "passthrough" {
  #: Leave passthrough
  bindsym $mod+Shift+p mode "default"
}
#: Passthrough: every key goes to the app (games)
bindsym $mod+Shift+p mode "passthrough"

### Bar: waybar, configured in ~/.config/waybar (dot_config/waybar in the chezmoi source).
# Started from here rather than as a systemd service so that `Super+Shift+R` restarts it with the rest of the config.
bar {
  swaybar_command waybar
}
#: Hide or show the bar
bindsym $mod+Shift+b exec pkill -SIGUSR1 waybar
