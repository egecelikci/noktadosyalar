# sway config.
# ~/.config/sway/config is a symlink to dot_config/sway/config in the chezmoi source (symlink mode, see .chezmoi.toml.tmpl there), so an edit is live after `Super+Shift+R` (reload) and versioned by a commit in that repo: there is no `chezmoi apply` step in between.
# Built on sway's own default config (/etc/sway/config), so `man 5 sway` and every tutorial describe these keys; what differs from it is commented where it differs.
#
# The mental model, one rule per modifier:
# - `Super+key` does a thing: focus, open, switch, toggle.
# - `Super+Shift+key` does the same thing to the focused window, or the bigger version of it: move instead of focus, send instead of switch, close, reload, exit, apply.
#   Screenshots are `Super+Shift+S` and then W, A or D, laid out like a game's WASD keys (see Screenshots below).
# - `Super+Ctrl+key` is the session itself: lock.
# - `h j k l` are left, down, up, right everywhere, as in vim; the arrow keys do the same.
# - A mode (`Super+R` resize, `Super+N` notifications, `Super+Shift+S` screenshot) is a small keyboard of its own: plain letters act, `Escape` leaves, and waybar shows the mode's name while you are in it.
# - Volume and play/pause are the keyboard's job, not sway's: they are on the NuPhy Fn layer, which sends the media keys handled under Media below.

# The NixOS sway module's drop-in: dbus-update-activation-environment, plus the systemctl --user import-environment and sway-session.target start.
# A custom config silently drops them unless it includes the directory, and then portals and systemd user services never see WAYLAND_DISPLAY.
include /etc/sway/config.d/*

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu fuzzel
set $lock swaylock -f -c 1d1f21
set $volume ~/.local/bin/volume

### Keyboard
# Turkish Q, plus two remaps done here rather than in the NuPhy firmware, so they are versioned and undone by deleting a word:
# - `caps:backspace` turns Caps Lock into a second Backspace.
# - `altwin:swap_lalt_lwin` swaps the bottom-left Alt and Win, so Super is the key directly left of the space bar, under the left thumb.
#   The ⌘ and Alt keycaps are swapped to match (2026-10-16), so the legends tell the truth: ⌘ is Super, Alt is Alt.
# If the same swap is ever done in the keyboard's firmware instead, delete `altwin:swap_lalt_lwin` here, or the two swaps cancel out.
input "type:keyboard" {
  xkb_layout tr
  xkb_options caps:backspace,altwin:swap_lalt_lwin
}

### Look
output * bg #1d1f21 solid_color
# Sway's own pointer, over the desktop and window borders.
# XCURSOR_THEME (modules/desktop.nix in the nixos repo) only reaches a sway started after it was set; this line also applies on a reload.
seat * xcursor_theme Bibata-Modern-Classic 24
# A 2px border instead of a title bar on every window, and no border at all when a window is alone on its workspace (from emersion's config).
default_border pixel 2
smart_borders on
hide_edge_borders smart
# class                 border  background text    indicator child_border
client.focused          #5f5aad #5f5aad    #ffffff #8f8ad6   #5f5aad
client.unfocused        #1d1f21 #1d1f21    #707880 #1d1f21   #1d1f21

### Session services
# mako shows notifications; `exec_always makoctl reload` makes `Super+Shift+R` pick up an edit to ~/.config/mako/config too.
exec mako
exec_always makoctl reload
# Every copy is recorded for `Super+C`; images as well as text, because wl-paste hands cliphist whatever type was copied.
exec wl-paste --watch cliphist store
# Lock after 10 minutes idle, screen off at 15, and always lock before a suspend.
exec swayidle -w \
  timeout 600 '$lock' \
  timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
  before-sleep '$lock'

### Basics
bindsym --no-repeat $mod+Return exec $term
# Space, like Spotlight or Raycast on macOS; pressing it again closes the launcher.
# ~/.local/bin/menu is shared by every fuzzel picker (also Super+C), so they all open and close the same way.
bindsym --no-repeat $mod+space exec ~/.local/bin/menu launcher
bindsym $mod+Shift+q kill
# Drag floating windows with Super + left mouse button, resize them with Super + right.
floating_modifier $mod normal
# R for reload: re-reads this file, restarts waybar, reloads mako. Open windows are untouched.
bindsym $mod+Shift+r reload
# C for chezmoi: `chezmoi apply` in a floating terminal, then a reload.
# Rarely needed, because these configs are symlinks into the chezmoi source and need no apply; it is for the files chezmoi still copies (templates, scripts in ~/.local/bin) and for pulling in changes made on another machine.
# The terminal stays open until Enter, so a question from chezmoi (a file changed on both sides) can be answered and its output read.
# fish rather than sh, because fish's config.fish is what exports BWS_ACCESS_TOKEN, which the Bitwarden-backed templates need.
bindsym --no-repeat $mod+Shift+c exec $term --app-id=chezmoi fish -c 'chezmoi apply -v; and swaymsg reload; echo; echo "Enter to close"; read'
for_window [app_id="chezmoi"] floating enable, resize set 1000 600
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes, exit sway' 'swaymsg exit'
# L for lock.
bindsym $mod+Ctrl+$right exec $lock

### Focus and move
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces: Super+N goes there, Super+Shift+N sends the window there.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
# Back to the workspace you came from.
bindsym $mod+Tab workspace back_and_forth

### Layout
# Where the next window opens: beside (b) or below (v) the focused one.
bindsym $mod+b splith
bindsym $mod+v splitv
# Stacking, tabbed, or back to tiled.
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
# T for toggle: move focus between the tiled windows and the floating ones (Super+Space used to do this in sway's default config; it now opens the launcher).
bindsym $mod+t focus mode_toggle
bindsym $mod+a focus parent

### Scratchpad: a hidden workspace for windows you summon and dismiss.
# On Turkish Q, `minus` is the key right of `*` on the number row (the `=` keycap on this board).
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

### Clipboard history: Super+C, pick an entry in fuzzel, and it is on the clipboard again; Super+C again closes it, like the launcher.
bindsym --no-repeat $mod+c exec ~/.local/bin/menu clipboard

### Resize: Super+R, then hjkl or arrows, then Return or Escape.
mode "resize" {
  bindsym $left resize shrink width 10px
  bindsym $down resize grow height 10px
  bindsym $up resize shrink height 10px
  bindsym $right resize grow width 10px
  bindsym Left resize shrink width 10px
  bindsym Down resize grow height 10px
  bindsym Up resize shrink height 10px
  bindsym Right resize grow width 10px
  bindsym Return mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Screenshots: Super+Shift+S, then a letter laid out like WASD.
# Keep Super+Shift held and add the letter, or let go and press it alone; both work.
#   W  a window: click the one you want
#   A  all of the screen
#   D  drag a region with the mouse
# Escape cancels; until a letter or Escape comes, the bar shows "screenshot" and the other keys do nothing.
# Every screenshot is both copied to the clipboard and saved to ~/Pictures/Screenshots, so there is no second choice to make; mako confirms each one.
# ~/.local/bin/screenshot does the capturing (grimshot: grim + slurp + swaymsg underneath) and lets only one run at a time.
# Every binding here is --no-repeat: a held key used to start a new selector on every repeat, stacking dimmed overlays until the screen went white.
# The board has no Print key, which is why these are chords.
set $shot ~/.local/bin/screenshot
mode "screenshot" {
  bindsym --no-repeat w exec $shot window, mode "default"
  bindsym --no-repeat a exec $shot screen, mode "default"
  bindsym --no-repeat d exec $shot area, mode "default"
  bindsym --no-repeat $mod+Shift+w exec $shot window, mode "default"
  bindsym --no-repeat $mod+Shift+a exec $shot screen, mode "default"
  bindsym --no-repeat $mod+Shift+d exec $shot area, mode "default"
  bindsym Escape mode "default"
}
bindsym --no-repeat $mod+Shift+s mode "screenshot"

### Media
# Super+M opens the mixer (wiremix, in a floating terminal): per-app volume, output and input devices.
bindsym --no-repeat $mod+m exec $term --app-id=mixer wiremix
for_window [app_id="mixer"] floating enable, resize set 900 600

# Volume and playback come from the keyboard: the NuPhy Fn layer sends these media keys, sway acts on them, and they keep working on the lock screen.
# Volume changes show as a mako notification with a level bar, through ~/.local/bin/volume.
bindsym --locked XF86AudioRaiseVolume exec $volume up
bindsym --locked XF86AudioLowerVolume exec $volume down
bindsym --locked XF86AudioMute exec $volume mute
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

### Notifications: Super+N, then
#   d        dismiss the newest
#   Shift+d  dismiss all
#   Return   act on the newest (opens the chat, the link, …) and dismiss it
#   u        bring back the last dismissed one ("undo")
# (also from emersion's config)
mode "notifications" {
  bindsym d exec makoctl dismiss, mode "default"
  bindsym Shift+d exec makoctl dismiss --all, mode "default"
  bindsym Return exec makoctl invoke && makoctl dismiss, mode "default"
  bindsym u exec makoctl restore, mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+n mode "notifications"

### Passthrough: Super+Shift+P hands every key to the focused window, Super included, until the same chord again.
# For games and VMs that want Super for themselves; the bar shows "passthrough" while it is on.
mode "passthrough" {
  bindsym $mod+Shift+p mode "default"
}
bindsym $mod+Shift+p mode "passthrough"

### Bar: waybar, configured in ~/.config/waybar (dot_config/waybar in the chezmoi source).
# Started from here rather than as a systemd service so that `Super+Shift+R` restarts it with the rest of the config.
# Super+Shift+B hides and shows it.
bar {
  swaybar_command waybar
}
bindsym $mod+Shift+b exec pkill -SIGUSR1 waybar
