# sway config.
# ~/.config/sway/config is a symlink to dot_config/sway/config in the chezmoi source (symlink mode, see .chezmoi.toml.tmpl there), so an edit is live after `Super+Shift+R` (reload) and versioned by a commit in that repo: there is no `chezmoi apply` step in between.
# That holds for these plain config files only. The files chezmoi copies instead of symlinking — `.tmpl` templates and the `executable_*` scripts in `~/.local/bin` — need `chezmoi apply` in a terminal.
# Built on sway's own default config (/etc/sway/config), so `man 5 sway` and every tutorial describe these keys; what differs from it is commented where it differs.
#
# The shortcut families:
# - `Super+key` does a thing: focus, open, switch, toggle, close.
# - `Super+Shift+key` moves instead of focusing, sends instead of switching, or reverses parent focus; it also handles reload.
#   Screenshots are `Super+Shift+S` and then W, A or D, laid out like a game's WASD keys (see Screenshots below).
# - `Super+Ctrl+HJKL` controls window size; `Super+Ctrl+Q` locks without ending the session.
# - `h j k l` are left, down, up, right everywhere, as in vim; the arrow keys do the same.
# - Screenshot mode (`Super+Shift+S`) is a small keyboard of its own: plain letters act and `Escape` leaves.
# - Volume and play/pause are the keyboard's job, not sway's: they are on the NuPhy Fn layer, which sends the media keys handled under Media below.

# The NixOS sway module's drop-in: dbus-update-activation-environment, plus the systemctl --user import-environment and sway-session.target start.
# A custom config silently drops them unless it includes the directory, and then portals and systemd user services never see WAYLAND_DISPLAY.
include /etc/sway/config.d/*

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $ipc noctalia msg
# The emergency locker must work even when the shell has not generated a theme.
set $lock $ipc session lock || swaylock -f -c 000000

# Steam starts with the session, hidden in the tray, so it processes Vulkan shaders while the machine idles instead of at game launch.
exec steam -silent

### Keyboard
# US first, because the Air60 HE wears US keycaps and that is the layout the labels describe; Turkish Q and Turkish F sit beside it, one chord away, for ğ ş ı ç ö ü.
# Every key remap lives in the board's own firmware (NuPhyIO), so it behaves the same on every computer and the system never second-guesses it.
# In the firmware (2026-10-16): Caps Lock sends Backspace, and the key directly left of the space bar sends Cmd (Super), with Opt (Alt) beside it.
# Do not add `caps:` or `altwin:` xkb options here; a second remap on top of the firmware's cancels it out, which is what happened before this was removed.
input "type:keyboard" {
  xkb_layout us,tr,tr
  xkb_variant ,,f
}
# The layout is a runtime property, so switching moves no physical key and the board's firmware is untouched.
# Recovery consoles do not follow this: their console.keyMap stays `us` in the nixos repo.
#: Switch the keyboard layout (us -> tr -> tr f -> back)
bindsym $mod+Ctrl+space exec swaymsg input type:keyboard xkb_switch_layout next

### Look
# Noctalia owns the wallpaper and reserves space for its bar.
# Sway's own pointer, over the desktop and window borders.
# XCURSOR_THEME (modules/desktop.nix in the nixos repo) only reaches a sway started after it was set; this line also applies on a reload.
seat * xcursor_theme Bibata-Modern-Classic 24
# A 2px border instead of a title bar on every window, drawn even when one window is alone on the workspace: with smart borders it would only appear when a second window opens, which shifts the first window's content by 2px.
# Edge borders are not hidden either: hiding one grows the window into it (measured: content 0,0 instead of 2,2), which is the same jump in reverse.
default_border pixel 2
smart_borders off
# Generated by Noctalia, which reloads Sway after palette changes; chezmoi must not own this output.
include ~/.config/sway/noctalia

### Session services
# The NixOS drop-in above starts the graphical session target; Home Manager starts Noctalia exactly once through its user service.
# Noctalia owns notifications, OSD, wallpaper and idle locking, so no competing daemons are started here.

### Basics
# Open a terminal (foot)
bindsym --no-repeat $mod+Return exec $term
# Space, like Spotlight or Raycast on macOS; pressing it again closes the launcher.
# Open or close the app launcher
bindsym --no-repeat $mod+space exec $ipc panel-toggle launcher
# Keep Super+V for vertical splits
# Clipboard manager
bindsym --no-repeat $mod+c exec $ipc panel-toggle clipboard
bindsym --no-repeat $mod+comma exec $ipc settings-toggle
# Close the focused window
bindsym $mod+Shift+q kill
# Drag floating windows with Super + left mouse button, resize them with Super + right.
floating_modifier $mod normal
focus_follows_mouse yes
# Reload only Sway; Noctalia watches its own configuration without restarting launched apps.
bindsym $mod+Shift+r reload
# Leave sway (asks first)
bindsym $mod+Ctrl+Shift+q exec swaynag -t warning -m 'Exit sway?' -B 'Yes, exit sway' 'swaymsg exit'
# Lock the screen
bindsym $mod+Ctrl+q exec $lock

### Focus and move
# Focus the window left, down, up or right
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move the window left, down, up or right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces: Super+N goes there, Super+Shift+N sends the window there.
# Go to workspace 1–10
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
# Send the window to workspace 1–10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
# Next workspace
bindsym $mod+Tab workspace next
# Previous workspace
# Shift+Tab arrives as ISO_Left_Tab, so the binding has to be made on the keycode to fire.
bindsym --to-code $mod+Shift+Tab workspace prev
# Back to the workspace you came from
bindsym $mod+Ctrl+Tab workspace back_and_forth

### Layout
# Open the next window beside the focused one
bindsym $mod+b splith
# Open the next window below the focused one
bindsym $mod+v splitv
# Stack the windows here (one title bar each)
bindsym $mod+s layout stacking
# Tab the windows here
bindsym $mod+w layout tabbed
# Back to tiled, or flip between side by side and stacked
bindsym $mod+e layout toggle split
# Fullscreen on or off
bindsym $mod+f fullscreen
# Float the window, or tile it again
bindsym $mod+Shift+space floating toggle
# T for toggle: Super+Space did this in sway's default config; it now opens the launcher.
# Move focus between tiled and floating windows
bindsym $mod+t focus mode_toggle
# Title bar on the focused window: cycles the 2px border, a title bar and none. New windows keep the 2px border from `default_border` above.
#: Add or remove a title bar on the focused window
bindsym $mod+Shift+t border toggle
# Focus the parent container
bindsym $mod+a focus parent
# Focus the last-focused child container
bindsym $mod+Shift+a focus child

### Scratchpad: a hidden workspace for windows you summon and dismiss.
# `minus` is `-` under us (under tr it is the key labelled `=` on this board).
# Hide the window in the scratchpad
bindsym $mod+Shift+minus move scratchpad
# Show or hide the scratchpad window
bindsym $mod+minus scratchpad show

### Resize: Ctrl controls size directly, without entering a mode.
# Shrink width or grow height, shrink height or grow width
bindsym $mod+Ctrl+$left resize shrink width 10px
bindsym $mod+Ctrl+$down resize grow height 10px
bindsym $mod+Ctrl+$up resize shrink height 10px
bindsym $mod+Ctrl+$right resize grow width 10px
bindsym $mod+Ctrl+Left resize shrink width 10px
bindsym $mod+Ctrl+Down resize grow height 10px
bindsym $mod+Ctrl+Up resize shrink height 10px
bindsym $mod+Ctrl+Right resize grow width 10px
# Width presets: a third, half, two thirds of the workspace, for the split you actually want instead of nudging it.
#: Resize the window to 1/3, 1/2 or 2/3 of the workspace
bindsym $mod+Ctrl+1 resize set width 33 ppt
bindsym $mod+Ctrl+2 resize set width 50 ppt
bindsym $mod+Ctrl+3 resize set width 66 ppt

### Screenshots: Super+Shift+S, then a letter laid out like WASD.
# Keep Super+Shift held and add the letter, or let go and press it alone; both work.
# Escape cancels; until a letter or Escape comes, the other keys do nothing.
# Noctalia saves and copies captures according to its screenshot settings.
# Every binding is --no-repeat so a held key cannot stack selection overlays.
# The board has no Print key, which is why these are chords.
mode "screenshot" {
  #: Screenshot the focused window
  bindsym --no-repeat w exec $ipc screenshot-window, mode "default"
  #: Screenshot the focused monitor
  bindsym --no-repeat a exec $ipc screenshot-fullscreen, mode "default"
  #: Screenshot a region (drag it)
  bindsym --no-repeat d exec $ipc screenshot-region, mode "default"
  #: Screenshot the focused window
  bindsym --no-repeat $mod+Shift+w exec $ipc screenshot-window, mode "default"
  #: Screenshot the focused monitor
  bindsym --no-repeat $mod+Shift+a exec $ipc screenshot-fullscreen, mode "default"
  #: Screenshot a region (drag it)
  bindsym --no-repeat $mod+Shift+d exec $ipc screenshot-region, mode "default"
  #: Cancel
  bindsym Escape mode "default"
}
# Screenshot mode (then W, A or D)
bindsym --no-repeat $mod+Shift+s mode "screenshot"

### Media
# Open the audio controls (per-app volume, devices)
bindsym --no-repeat $mod+m exec $ipc panel-toggle control-center audio

# Volume and playback come from the keyboard: the NuPhy Fn layer sends these media keys, sway acts on them, and they keep working on the lock screen.
# Noctalia supplies the OSD and caps volume at 100%.
# Volume up, down, mute (keyboard media keys)
bindsym --locked XF86AudioRaiseVolume exec $ipc volume-up
bindsym --locked XF86AudioLowerVolume exec $ipc volume-down
bindsym --locked XF86AudioMute exec $ipc volume-mute
# Microphone mute (keyboard media key)
bindsym --locked XF86AudioMicMute exec $ipc mic-mute
# Play/pause, next, previous (keyboard media keys)
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

### Notifications
bindsym --no-repeat $mod+n exec $ipc panel-toggle control-center notifications

### Passthrough: keep media keys and screen locking available without other desktop shortcuts interrupting games.
mode "passthrough" {
  bindsym --locked XF86AudioRaiseVolume exec $ipc volume-up
  bindsym --locked XF86AudioLowerVolume exec $ipc volume-down
  bindsym --locked XF86AudioMute exec $ipc volume-mute
  bindsym --locked XF86AudioMicMute exec $ipc mic-mute
  bindsym --locked XF86AudioPlay exec playerctl play-pause
  bindsym --locked XF86AudioPause exec playerctl play-pause
  bindsym --locked XF86AudioNext exec playerctl next
  bindsym --locked XF86AudioPrev exec playerctl previous
  bindsym $mod+Ctrl+q exec $lock
  #: Leave passthrough
  bindsym $mod+Shift+p mode "default"
}
# Toggle game passthrough.
bindsym $mod+Shift+p mode "passthrough"

# Hide or show Noctalia's bar
bindsym $mod+Shift+b exec $ipc bar-toggle
