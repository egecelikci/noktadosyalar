# mako, the notification daemon. `man 5 mako` lists every key.
# ~/.config/mako/config is a symlink to dot_config/mako/config in the chezmoi source (symlink mode, see .chezmoi.toml.tmpl there); `Super+Shift+R` reloads it (`exec_always makoctl reload` in the sway config).

# Colors from Motif: background, text, the accent border, the progress-bar color and the red border of urgent notifications, generated by motif and reached through the ~/.config/motif symlink.
# Everything below the include can still override it.
include=~/.config/motif/mako/motif-dark.ini

font=sans 11
border-size=2
border-radius=8
padding=12
width=360
# Top right, under waybar.
anchor=top-right
margin=10
# Ordinary notifications go away by themselves after 5 seconds; Super+N, U brings the last one back.
default-timeout=5000

# Collapsed notifications ("and 3 more") stay quiet.
[hidden]
format=(and %h more)

# Urgent ones (a failed job) stay until dismissed; their red border comes from the Motif include above.
[urgency=high]
default-timeout=0

# The volume notification is a short-lived on-screen display, so it sits in the middle and has no border.
[app-name=volume]
anchor=center
border-size=0
default-timeout=1500

# A fullscreen window renders above mako's default `top` layer in sway (measured 2026-10-17: the notification was behind a fullscreen feishin), so a notification that lands while a game is running is invisible. Only game mode's is forced above it: everything else can wait behind the game, and the alerts that matter go to ntfy.
[app-name=game-mode]
layer=overlay
