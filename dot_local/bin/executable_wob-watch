#!/usr/bin/env fish
# # wob-watch
#
# Hides the wob bar the moment a window goes fullscreen.
#
# ~/.local/bin/volume draws nothing while something is fullscreen, but a bar that is already up stays until wob's 1.2s timeout.
# Sway announces the change (`swaymsg -t subscribe`), so this writes a fully transparent frame — `0 hidden`, the `[style.hidden]` in the motif fragment — into wob's FIFO: the surface vanishes at once, and wob drops it entirely on its next timeout.
#
# Sway keeps it running (`exec_always` in ~/.config/sway/config restarts it on a reload); the subscription ends by itself when sway exits.

set -l fifo (set -q XDG_RUNTIME_DIR; and echo $XDG_RUNTIME_DIR; or echo /tmp)/wob.fifo

swaymsg -t subscribe -m '["window"]' | while read -l event
    echo $event | jq -e 'select(.change == "fullscreen_mode" and .container.type != "workspace" and .container.fullscreen_mode != 0)' >/dev/null 2>&1
    or continue
    # wob holds the FIFO read-write; with no reader, opening it for writing would block this loop for ever.
    pgrep -x wob >/dev/null; and test -p $fifo; and echo "0 hidden" >$fifo
end
