#!/usr/bin/env fish
# # screenshot
#
# Takes one screenshot, copies it to the clipboard and saves it to `~/Pictures/Screenshots`.
#
# Called by the sway screenshot mode (`Super+Shift+S`, then W, A or D).
# Only one screenshot runs at a time: a second call while one is in progress (a held key, a double press, a second region selection) exits at once instead of stacking another selector on the screen.
# The guard is a non-blocking `flock` on a file in `$XDG_RUNTIME_DIR`, so it is atomic and disappears with the session.
# The capturing itself is grimshot's `savecopy` (grim + slurp + swaymsg), which also posts the confirmation through mako.

set -l dir ~/Pictures/Screenshots
set -l lock (set -q XDG_RUNTIME_DIR; and echo $XDG_RUNTIME_DIR; or echo /tmp)/screenshot.lock

# grimshot calls the whole screen `output`.
switch "$argv[1]"
    case window area
        set target $argv[1]
    case screen
        set target output
    case '*'
        echo "usage: screenshot window|screen|area" >&2
        exit 2
end

mkdir -p $dir
exec flock --nonblock $lock grimshot --notify savecopy $target $dir/(date +%F_%H-%M-%S).png
