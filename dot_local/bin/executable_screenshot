#!/usr/bin/env fish
# Capture a window, region or focused monitor as PNG, then save it and copy it.

if test (count $argv) -ne 1; or not contains -- "$argv[1]" window screen area
    echo "usage: screenshot window|screen|area" >&2
    exit 2
end

if not set -q XDG_RUNTIME_DIR; or not test -d "$XDG_RUNTIME_DIR"
    echo "screenshot: XDG_RUNTIME_DIR must name an existing session directory" >&2
    exit 1
end

function fail --description 'Report a screenshot failure without discarding an already saved image' --argument-names message
    echo "screenshot: $message" >&2
    notify-send --app-name=screenshot --urgency=critical 'Screenshot failed' "$message" >/dev/null 2>&1
    exit 1
end

umask 077
set -l lock "$XDG_RUNTIME_DIR/screenshot.lock"
touch "$lock"; or exit 1

# Hold the lock on stdin; wl-copy receives the image as stdin instead, so its background child cannot retain the lock.
begin
    flock --nonblock 0; or exit 1

    set -l capture
    switch $argv[1]
        case screen
            set -l output (swaymsg -t get_outputs | jq -er '.[] | select(.focused) | .name')
            test $status -eq 0; and test (count $output) -eq 1; or fail 'Cannot find the focused monitor'
            set capture -o "$output"
        case window area
            set -l accent (jq -er '.dark.primary | select(type == "string" and test("^#[0-9a-fA-F]{6}$"))' ~/.config/motif/spec/palette.json)
            test $status -eq 0; and test (count $accent) -eq 1; or fail 'Cannot read the Motif selection color'
            set -l picker -b '#00000040' -B '#00000040' -s '#00000000' -c "$accent" -w 2
            set -l geometry
            if test "$argv[1]" = window
                set -l windows (swaymsg -t get_tree | jq -er '.. | objects | select(.pid? and .visible?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"')
                test $status -eq 0; and test (count $windows) -gt 0; or fail 'Cannot find any visible windows'
                set geometry (printf '%s\n' $windows | slurp $picker -r); or exit 1
            else
                set geometry (slurp $picker -d </dev/null); or exit 1
            end
            test (count $geometry) -eq 1; and test -n "$geometry"; or exit 1
            set capture -g "$geometry"
    end

    set -l dir ~/Pictures/Screenshots
    mkdir -p "$dir"; or fail 'Cannot create the screenshot directory'
    set -l id (uuidgen --time-v7); or fail 'Cannot generate a screenshot filename'
    set -l file "$dir/$id.png"
    # Reserve the filename without overwriting an existing image, even on a UUID collision.
    printf '' >?"$file"; or fail 'Cannot reserve the screenshot filename'

    grim -t png $capture "$file"
    if test $status -ne 0; or not test -s "$file"
        rm -f -- "$file"
        fail 'Capture failed'
    end

    wl-copy --type image/png <"$file"; or fail "Saved to $file, but clipboard copying failed"
    notify-send --app-name=screenshot --expire-time=3000 --icon="$file" 'Screenshot saved and copied' "$file"; or echo "screenshot: saved to $file, but notification failed" >&2
    printf '%s\n' "$file"
end <"$lock"
