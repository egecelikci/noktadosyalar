#!/usr/bin/env fish
# # volume
#
# Changes the default output's volume and shows the new level on wob.
#
# Called by the keyboard's volume keys (the NuPhy Fn layer) through `~/.config/sway/config`, and by waybar's scroll on the volume module.
# The step is `$step` percent; the level is capped at 100%, because PipeWire otherwise lets it climb into distortion.
# sway keeps wob alive on a FIFO opened read-write, so writing the level never blocks; wob's own timeout hides the bar again.
# While the sink is muted the level is sent with wob's `muted` style, so a silenced output is visible instead of looking like a low volume.

set -l sink @DEFAULT_AUDIO_SINK@
set -l step 2
# Set to 0 to change the volume silently: waybar's wireplumber module is then the only indicator, and nothing is written to wob.
set -l show_bar 1
set -l fifo (set -q XDG_RUNTIME_DIR; and echo $XDG_RUNTIME_DIR; or echo /tmp)/wob.fifo

switch "$argv[1]"
    case up
        wpctl set-volume -l 1.0 $sink $step%+
    case down
        wpctl set-volume $sink $step%-
    case mute
        wpctl set-mute $sink toggle
    case '*'
        echo "usage: volume up|down|mute" >&2
        exit 2
end

# `wpctl get-volume` prints `Volume: 0.45`, with ` [MUTED]` appended when muted.
set -l state (wpctl get-volume $sink)
set -l line (math --scale=0 "round("(string split ' ' $state)[2]" * 100)")
string match -q '*MUTED*' $state; and set line "$line muted"

if test "$show_bar" = 1
    # Only write while wob holds the FIFO: without a reader, opening it for writing would block the volume keys.
    pgrep -x wob >/dev/null; and test -p $fifo; and echo $line >$fifo
end
