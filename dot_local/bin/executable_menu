#!/usr/bin/env fish
# # menu
#
# Opens a fuzzel picker, or closes the one that is already open.
#
# The one entry point for every fuzzel-based picker in the sway config, so they all behave the same way: the chord that opens a picker closes it again, and pressing another picker's chord while one is open only closes the open one.
# Holding a chord does nothing extra, because the sway bindings that call this use `--no-repeat`; this script only decides between opening and closing.
#
# Pickers:
#
# - `launcher` — fuzzel's own application launcher (`Super+Space`).
# - `clipboard` — clipboard history from cliphist (`Super+C`); the chosen entry goes back on the clipboard.

function close_open --description 'Close fuzzel if it is open; succeeds only when there was one to close'
    pkill -x fuzzel
end

function clipboard --description 'Show the clipboard history and put the chosen entry back on the clipboard'
    # Escape makes fuzzel exit non-zero with no output; that is a normal "never mind", not an error.
    set -l choice (cliphist list | fuzzel --dmenu --prompt 'clipboard> ')
    or return 0
    printf '%s\n' $choice | cliphist decode | wl-copy
end

switch "$argv[1]"
    case launcher clipboard
    case '*'
        echo "usage: menu launcher|clipboard" >&2
        exit 2
end

close_open; and exit 0

switch $argv[1]
    case launcher
        exec fuzzel
    case clipboard
        clipboard
end
