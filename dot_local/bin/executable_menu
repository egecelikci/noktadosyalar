#!/usr/bin/env fish
# # menu
#
# Opens a fuzzel picker, or closes the one that is already open.
#
# The one entry point for every fuzzel-based picker in the sway config, so they all behave the same way: the chord that opens a picker closes it again, and pressing another picker's chord while one is open only closes the open one.
# Holding a chord does nothing extra, because the sway bindings that call this use `--no-repeat`; this script only decides between opening and closing.
#
# Pickers:
#
# - `launcher` — fuzzel's own application launcher (`Super+Space`).
# - `clipboard` — clipboard history from cliphist (`Super+C`); the chosen entry goes back on the clipboard.
# - `keys` — every sway key binding with its `#:` description from ~/.config/sway/config (`Super+Escape`); picking one runs it.

function close_open --description 'Close fuzzel if it is open; succeeds only when there was one to close'
    pkill -x fuzzel
end

function clipboard --description 'Show the clipboard history, images as thumbnails, and put the chosen entry back on the clipboard'
    # cliphist lists `<id>\t<preview>`, newest first; images preview as `[[ binary data 185 KiB png 1440x900 ]]`.
    set -l entries (cliphist -preview-width 200 list)
    test (count $entries) -gt 0; or return 0

    # PNG images get their own picture as the row's icon, through Rofi's dmenu extension that fuzzel supports (`<text>\0icon\x1f<path>`).
    # Each image is decoded once, into a per-session cache keyed by its cliphist id, so reopening the picker stays fast.
    # Other image types stay text rows: fuzzel only draws PNG and SVG icons.
    set -l thumbs $XDG_RUNTIME_DIR/cliphist-thumbs
    mkdir -p $thumbs

    # The ids are hidden from the rows; `--index` returns the position instead, which maps back to the cliphist line.
    set -l choice (for entry in $entries
            set -l parts (string split --max 1 \t -- $entry)
            if string match -qr '^\[\[ binary data .* png ' -- $parts[2]
                set -l thumb $thumbs/$parts[1].png
                test -s $thumb; or printf '%s\n' $entry | cliphist decode >$thumb
                command printf '%s\0icon\037%s\n' "image  "(string replace -r '^\[\[ binary data (.*) \]\]$' '$1' -- $parts[2]) $thumb
            else
                printf '%s\n' $parts[2]
            end
        end | fuzzel --dmenu --index --prompt 'clipboard> ' --width 70 --lines 14)
    # Escape makes fuzzel exit non-zero with no output; that is a normal "never mind", not an error.
    or return 0

    printf '%s\n' $entries[(math $choice + 1)] | cliphist decode | wl-copy
end

function pretty_keys --description 'Write key combos the way they are printed on keycaps: `Super+Shift+q` becomes `Super Shift Q`, a group of directions becomes `Super H J K L`'
    set -l out
    for combo in $argv
        set -l parts (string split + -- $combo)
        set -l key $parts[-1]
        switch $key
            case space
                set key Space
            case Return
                set key Enter
            case minus
                set key -
            case Left Down Up Right
                # The arrows repeat the h/j/k/l row; listing both only doubles the width.
                continue
        end
        # Letters as they are printed on the keycap.
        test (string length -- $key) -eq 1; and set key (string upper -- $key)
        set -a out (string join ' ' -- $parts[1..-2] $key)
    end
    # A group sharing the same modifiers prints the modifiers once: `Super H J K L`, `Super 1 … 0`.
    set -l first (string split ' ' -- $out[1])
    set -l mods $first[1..-2]
    if test (count $out) -gt 1; and test (count $mods) -eq 0; and test (count (string match -- '* *' $out)) -eq 0
        # Bare keys, as inside a mode: `H J K L`.
        string join ' ' -- $out
    else if test (count $out) -gt 1; and test (count (string match -- "$mods *" $out)) -eq (count $out)
        set -l keys (string replace -- "$mods " '' $out)
        if test (count $keys) -ge 10
            set keys $keys[1] … $keys[-1]
        end
        echo (string join ' ' -- $mods $keys)
    else
        string join ' / ' -- $out
    end
end

function keys --description 'List every sway binding with its `#:` description, and run the one that is picked'
    # Read the config sway is using, so the list can never drift from the actual bindings.
    set -l vars
    set -l values
    set -l section
    set -l desc
    set -l mode
    # One row per group of consecutive bindings that share a description.
    set -l row_desc
    set -l row_mode
    set -l row_combos
    set -l row_command

    for line in (string trim -- (cat ~/.config/sway/config))
        switch $line
            case 'set $*'
                # `set $mod Mod4` is remembered so `$mod+h` can be shown as `Super+h`.
                set -l parts (string split --max 2 ' ' -- $line)
                set -a vars $parts[2]
                set -a values $parts[3]
            case '### *'
                set section (string replace -r '^### ([^:.]*).*' '$1' -- $line)
                set desc
            case '#:*'
                set desc (string replace -r '^#:\s*' '' -- $line)
            case '#*' ''
            case 'mode "*" {'
                set mode (string replace -r '^mode "([^"]+)".*' '$1' -- $line)
            case '}'
                set mode
            case 'bindsym *'
                set -l words (string split ' ' -- $line)
                # Step over flags such as --no-repeat and --locked to reach the key combo.
                set -l i 2
                while string match -q -- '--*' $words[$i]
                    set i (math $i + 1)
                end
                set -l combo $words[$i]
                for n in (seq (count $vars))
                    set combo (string replace -a -- $vars[$n] $values[$n] $combo)
                end
                set combo (string replace -a Mod4 Super -- $combo)
                set -l what $desc
                test -n "$what"; or set what $section
                set -l last (count $row_desc)
                if test $last -gt 0; and test "$row_desc[$last]" = "$what"; and test "$row_mode[$last]" = "$mode"
                    set row_combos[$last] "$row_combos[$last] $combo"
                    # A group runs nothing when picked: which of its keys was meant is unknown.
                    set row_command[$last] ''
                else
                    set -a row_desc $what
                    set -a row_mode "$mode"
                    set -a row_combos $combo
                    set -a row_command (string join ' ' -- $words[(math $i + 1)..-1])
                end
            case '*'
                # Any other statement ends the description above it.
                set desc
        end
    end

    # Which chord enters each mode, so a key inside a mode can be shown as the full sequence (`Super Shift S, then W`).
    set -l mode_names
    set -l mode_chords
    for n in (seq (count $row_desc))
        if test -z "$row_mode[$n]"; and string match -qr '^mode "[^"]+"$' -- $row_command[$n]
            set -a mode_names (string replace -r '^mode "([^"]+)"$' '$1' -- $row_command[$n])
            set -a mode_chords (string split ' ' -- $row_combos[$n])[1]
        end
    end

    set -l rows
    set -l keep
    for n in (seq (count $row_desc))
        set -l combos (string split ' ' -- $row_combos[$n])
        # Media keys are the keyboard's job and have no chord to learn; inside a mode, the held-modifier duplicates (Super+Shift+W next to W) and Escape only add noise.
        string match -q 'XF86*' -- $combos[1]; and continue
        if test -n "$row_mode[$n]"
            set combos (string match -v -- 'Super+*' $combos)
            set combos (string match -v -- Escape $combos)
            test (count $combos) -gt 0; or continue
        end
        set -l shown (pretty_keys $combos)
        if test -n "$row_mode[$n]"
            set -l i (contains --index -- $row_mode[$n] $mode_names)
            and set shown (pretty_keys $mode_chords[$i])", then $shown"
        end
        set -a rows (printf '%-60s %s' $row_desc[$n] $shown)
        set -a keep $n
    end

    # A monospace face keeps the key column aligned.
    set -l choice (printf '%s\n' $rows | fuzzel --dmenu --index --prompt '  ' --placeholder 'Search what a key does' --font 'monospace:size=12' --width 92 --lines 16)
    or return 0
    set -l n $keep[(math $choice + 1)]
    # Picking a row runs that binding, so the list doubles as a command palette; bindings that only exist inside a mode are not run from here.
    if test -n "$row_command[$n]"; and test -z "$row_mode[$n]"
        swaymsg -- $row_command[$n] >/dev/null
    end
end

switch "$argv[1]"
    case launcher clipboard keys
    case '*'
        echo "usage: menu launcher|clipboard|keys" >&2
        exit 2
end

close_open; and exit 0

switch $argv[1]
    case launcher
        exec fuzzel
    case clipboard
        clipboard
    case keys
        keys
end
