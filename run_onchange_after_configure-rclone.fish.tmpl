{{ if eq .chezmoi.os "android" }}#!/data/data/com.termux/files/usr/bin/fish{{ else }}#!/usr/bin/env fish{{ end }}

{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "android") }}
# This hash ensures the script re-runs if your Bitwarden secrets change
# secrets_hash: {{ (bitwardenSecrets .bitwarden.gdrive_client_id_id).value | sha256sum }}

if not command -v rclone >/dev/null 2>&1
    echo "rclone not installed; skipping"
    exit 0
end

echo "Configuring Rclone remotes…"

mkdir -p ~/.config/rclone

# Every call passes --no-output, because rclone otherwise prints the whole
# remote, including the client secret and OAuth token, into the apply output.

# 1. Update the Google Drive remote's credentials, keeping its token. This never
#    starts a browser login (--non-interactive); if the remote has no token yet,
#    run `rclone config reconnect Drive:` once by hand.
if not rclone config update Drive client_id '{{ (bitwardenSecrets .bitwarden.gdrive_client_id_id).value }}' client_secret '{{ (bitwardenSecrets .bitwarden.gdrive_client_secret_id).value }}' --non-interactive --no-output
    echo "Drive: not updated (no token yet?). Run: rclone config reconnect Drive:"
end

# 2. Configure the static HTTP remotes: update if they exist, otherwise create.
for remote in Myrient "The Eye" 8BitDo
    switch $remote
        case Myrient
            set url "https://myrient.erista.me"
        case "The Eye"
            set url "https://beta.the-eye.eu"
        case 8BitDo
            set url "https://tempfiles.8bitdo.com/SPSP/"
    end
    rclone config update "$remote" type http url "$url" --no-output 2>/dev/null
    or rclone config create "$remote" http url "$url" --no-output
end

# 3. Configure the Dufs WebDAV remote
rclone config create dufs webdav \
    url "https://dufs.celikci.me" \
    vendor other \
    user '{{ (bitwardenSecrets .bitwarden.username_id).value }}' \
    pass '{{ (bitwardenSecrets .bitwarden.dufs_webdav_password_id).value }}' \
    --obscure --no-output

echo "Rclone configuration successfully synced!"
{{ else }}
# On NixOS the rclone config is managed declaratively via sops
# (nixos repo: storage.nix / rclone-secrets.yaml).
echo "rclone config is managed via sops on this machine"
{{ end }}
